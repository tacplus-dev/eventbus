# Build eventbus codegen maven plugin.

TACPLUS_IMAGE := "registry.gitlab.com/seabeam/schematic/tacplus/tacplus-1-2:latest"

default: build

build:
  #!/usr/bin/env bash
  set -euo pipefail
  docker run --rm \
    -v "$(cd .. && pwd)":/workspace \
    -v "${HOME}/.m2:/root/.m2" \
    -w /workspace \
    "{{TACPLUS_IMAGE}}" \
    mvn -pl codegen -am package -DskipTests
