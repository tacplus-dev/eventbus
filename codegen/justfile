# Build eventbus codegen maven plugin.

tacplus_image := "registry.gitlab.com/secondstarcavalier/controlplane/utils/tacplus/tacplus-1-1:latest"

default: build

build:
  #!/usr/bin/env bash
  set -euo pipefail
  docker run --rm \
    -v "$(cd .. && pwd)":/workspace \
    -v "${HOME}/.m2:/root/.m2" \
    -w /workspace \
    {{tacplus_image}} \
    mvn -pl codegen -am package -DskipTests
