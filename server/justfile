# Build eventbus-server shaded jar.

TACPLUS_IMAGE := "registry.gitlab.com/secondstarcavalier/schematic/tacplus/tacplus-1-2:latest"

default: build

build:
  #!/usr/bin/env bash
  set -euo pipefail
  docker run --rm \
    -v "$(cd .. && pwd)":/workspace \
    -v "${HOME}/.m2:/root/.m2" \
    -w /workspace \
    "{{TACPLUS_IMAGE}}" \
    mvn -pl server -am package -DskipTests
