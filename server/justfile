# Build eventbus-server shaded jar.

tacplus_image := "registry.gitlab.com/secondstarcavalier/controlplane/services/tacplus/tacplus-1-1:latest"

default: build

build:
  #!/usr/bin/env bash
  set -euo pipefail
  docker run --rm \
    -v "$(cd .. && pwd)":/workspace \
    -v "${HOME}/.m2:/root/.m2" \
    -w /workspace \
    {{tacplus_image}} \
    mvn -pl server -am package -DskipTests
