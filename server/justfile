# Build eventbus-server shaded jar.

TACPLUS_IMAGE := "ghcr.io/tacplus-dev/tacplus/tacplus:2.0.2"

default: build

build:
  #!/usr/bin/env bash
  set -euo pipefail
  docker run --rm \
    -v "$(cd .. && pwd)":/workspace \
    -v "${HOME}/.m2:/root/.m2" \
    -w /workspace \
    "{{TACPLUS_IMAGE}}" \
    mvn -pl server -am package -DskipTests
